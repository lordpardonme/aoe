# ---------------------------------------------------------------------------
# Job Agent configuration. Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# --- Google auth ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Google Sheets tracker ---
# The spreadsheet ID is the long token in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Leave blank to have the agent create a tracker for you on first run.
TRACKER_SPREADSHEET_ID=
TRACKER_SHEET_NAME=Applications

# --- Candidate identity (used in cover letters / emails / resume header) ---
CANDIDATE_NAME=Mohd Hayaat Ali
CANDIDATE_EMAIL=mohdhayaat1@outlook.com
CANDIDATE_PHONE=+91-7905194153
CANDIDATE_LOCATION=Delhi NCR, India
CANDIDATE_PORTFOLIO=https://workofhayaat.framer.website
CANDIDATE_LINKEDIN=

# --- Email sending ---
# The Gmail account that owns token.json sends the mail ("me").
SENDER_EMAIL=hayaat0806@gmail.com
# Default recipient when a job description has no contact email.
DEFAULT_RECIPIENT=

# --- Behaviour ---
# When true, `apply`/`send` build everything but DO NOT actually send email
# or write to Sheets. Flip to false when you are ready to fire for real.
DRY_RUN=true

# Number of retry attempts for network operations (Gmail / Sheets / fetch).
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
